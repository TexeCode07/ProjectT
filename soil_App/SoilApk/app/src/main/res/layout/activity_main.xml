<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/plant2"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="100dp"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Nitrogen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Nitrogen(N)"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"/>
            <TextView
                android:id="@+id/nval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="__mg/Kg"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

        <!-- Phosphorus -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Phosphorus(P)"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"/>
            <TextView
                android:id="@+id/pval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="__mg/Kg"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

        <!-- Potassium -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Potassium(K)"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"/>
            <TextView
                android:id="@+id/kval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="__mg/Kg"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

        <!-- pH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="pH"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"/>
            <TextView
                android:id="@+id/phval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0-14"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

        <!-- Moisture -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Moisture"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"/>
            <TextView
                android:id="@+id/moistval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

        <!-- Electric Conductivity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Electric Conductivity"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"/>
            <TextView
                android:id="@+id/electval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Crop Suggestion Header -->
    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:text="Crop Suggestion"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

    <!-- Crop Suggestion Value -->
    <TextView
        android:id="@+id/cropSug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="_______"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

</androidx.constraintlayout.widget.ConstraintLayout>
